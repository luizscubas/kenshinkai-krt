---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/siteConfig';
import serafimPhoto from '../assets/images/sensei-serafim.png';
import serafimCarteirinha from '../assets/images/carteirinha-Serafim.png';

const senseis = siteConfig.senseis;
// Sensei padrão selecionado inicialmente (Serafim possui fotos e carteirinha completas)
const defaultSenseiId = 'serafim';
---

<section id="mestres" class="py-20 bg-tatame border-b border-white/10 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Cabeçalho da Seção -->
    <div class="text-center mb-12 sm:mb-16">
      <p class="text-crimson text-sm font-semibold tracking-widest uppercase mb-2 font-body">
        Mestres Responsáveis
      </p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-normal text-white font-title tracking-wide">
        Liderança e Experiência Técnica
      </h2>
    </div>

    <!-- Container Geral com flex-col para controlar a ordem no mobile vs desktop -->
    <div class="flex flex-col">
      <!-- Botões de Seleção de Senseis (no mobile aparecem no topo como abas fáceis de tocar; no desktop ficam abaixo das 3 colunas) -->
      <div
        class="order-1 lg:order-2 grid grid-cols-3 gap-3 sm:gap-6 mb-8 lg:mb-0 lg:mt-8"
        role="tablist"
        aria-label="Seleção de Senseis"
      >
        {senseis.map((sensei) => {
          const isDefault = sensei.id === defaultSenseiId;
          return (
            <button
              type="button"
              role="tab"
              id={`tab-btn-${sensei.id}`}
              data-sensei-target={sensei.id}
              aria-selected={isDefault ? 'true' : 'false'}
              aria-controls={`sensei-panel-${sensei.id}`}
              class:list={[
                "sensei-tab-btn py-3.5 sm:py-4 px-2 sm:px-6 font-body font-bold text-sm sm:text-base md:text-lg transition-all duration-200 text-center uppercase tracking-wider cursor-pointer select-none",
                isDefault
                  ? "bg-crimson text-white shadow-lg shadow-crimson/30 border-2 border-crimson"
                  : "bg-surface-card hover:bg-crimson/30 border border-crimson/40 text-neutral-300 hover:text-white"
              ]}
            >
              {sensei.shortName}
            </button>
          );
        })}
      </div>

      <!-- Painéis de Conteúdo de cada Sensei (3 Colunas) -->
      <div class="order-2 lg:order-1">
        {senseis.map((sensei) => {
          const isDefault = sensei.id === defaultSenseiId;
          const isSerafim = sensei.id === 'serafim';

          return (
            <div
              id={`sensei-panel-${sensei.id}`}
              role="tabpanel"
              aria-labelledby={`tab-btn-${sensei.id}`}
              class:list={[
                "sensei-panel grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch",
                !isDefault && "hidden"
              ]}
            >
              <!-- Coluna 1 (Esquerda): Credencial / Carteirinha Oficial -->
              <div class="order-3 lg:order-1 flex flex-col justify-center items-center bg-surface-dark border border-white/10 p-4 sm:p-6 min-h-[360px] sm:min-h-[420px]">
                {isSerafim ? (
                  <div class="w-full max-w-[280px] sm:max-w-[320px] aspect-[290/387] overflow-hidden border border-white/10 bg-black/40 flex items-center justify-center">
                    <Image
                      src={serafimCarteirinha}
                      alt={`Carteirinha oficial de ${sensei.name}`}
                      class="w-full h-full object-contain"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <div class="w-full max-w-[280px] sm:max-w-[320px] aspect-[290/387] border border-white/10 bg-surface-card/60 p-6 flex flex-col justify-between items-center text-center">
                    <div class="flex flex-col items-center">
                      <img
                        src="/dojologo.svg"
                        alt="Logo Kenshinkai"
                        class="w-16 h-16 object-contain mb-3 opacity-90"
                        width="64"
                        height="64"
                      />
                      <p class="text-xs text-crimson font-bold uppercase tracking-widest font-body">Credencial Oficial</p>
                      <h4 class="text-white font-title text-base mt-1">{sensei.shortName}</h4>
                    </div>
                    <div class="space-y-1.5 py-4 border-y border-white/10 w-full text-xs text-neutral-300 font-body">
                      <p><strong class="text-white">Graduação:</strong> {sensei.rank}</p>
                      <p><strong class="text-white">Modalidade:</strong> {sensei.modality}</p>
                      <p><strong class="text-white">Filiação:</strong> {sensei.affiliation}</p>
                    </div>
                    <p class="text-[11px] text-neutral-500 font-body">
                      Associação Karatê Kenshinkai • Registro Oficial
                    </p>
                  </div>
                )}
              </div>

              <!-- Coluna 2 (Centro): Foto do Sensei -->
              <div class="order-1 lg:order-2 flex flex-col justify-center items-center bg-surface-dark border border-white/10 p-4 sm:p-6 min-h-[360px] sm:min-h-[420px]">
                {isSerafim ? (
                  <div class="w-full max-w-[280px] sm:max-w-[320px] aspect-[290/387] overflow-hidden border border-white/10 bg-black flex items-center justify-center">
                    <Image
                      src={serafimPhoto}
                      alt={`Foto de ${sensei.name}`}
                      class="w-full h-full object-cover"
                      loading="eager"
                    />
                  </div>
                ) : (
                  <div class="w-full max-w-[280px] sm:max-w-[320px] aspect-[290/387] border border-white/10 bg-surface-card/40 flex flex-col items-center justify-center p-6 text-center">
                    <img
                      src="/dojologo.svg"
                      alt="Emblema do Dojô Kenshinkai"
                      class="w-20 h-20 object-contain mb-4 opacity-50"
                      width="80"
                      height="80"
                    />
                    <p class="text-lg font-title text-white mb-1">{sensei.name}</p>
                    <p class="text-xs text-crimson font-body uppercase tracking-wider">{sensei.role}</p>
                  </div>
                )}
              </div>

              <!-- Coluna 3 (Direita): Card de Informações Técnicas -->
              <div class="order-2 lg:order-3 bg-surface-card border border-white/10 p-6 sm:p-8 flex flex-col justify-between min-h-[360px] sm:min-h-[420px]">
                <div>
                  <!-- Nome com fonte Zenzai Itacha -->
                  <h3 class="text-2xl sm:text-3xl font-normal text-white mb-2 font-title leading-tight">
                    {sensei.name}
                  </h3>

                  <!-- Graduação e Cargo com fonte Panoragraf -->
                  <p class="text-crimson font-semibold text-sm sm:text-base uppercase tracking-wider mb-2 font-body">
                    {sensei.rank} • {sensei.role}
                  </p>

                  <!-- Modalidade -->
                  <p class="text-xs sm:text-sm text-neutral-400 mb-4 font-body">
                    <strong class="text-neutral-200">Modalidade:</strong> {sensei.modality}
                  </p>

                  <div class="w-full h-px bg-white/10 mb-5"></div>

                  <!-- Biografia / Histórico com fonte Panoragraf -->
                  <p class="text-neutral-300 leading-relaxed text-sm sm:text-base font-body">
                    {sensei.bio}
                  </p>
                </div>

                <!-- Rodapé informativo do card -->
                {sensei.affiliation && (
                  <div class="pt-6 border-t border-white/10 mt-6 flex items-center justify-between text-xs text-neutral-400 font-body">
                    <span>{sensei.affiliation}</span>
                    <span class="text-crimson font-medium">Kenshinkai Dojô</span>
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<!-- Script interativo para alternar as abas dos senseis -->
<script>
  function setupSenseiTabs() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.sensei-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.sensei-panel');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-sensei-target');
        if (!targetId) return;

        // Atualiza estado de todos os botões
        tabButtons.forEach((b) => {
          const isTarget = b.getAttribute('data-sensei-target') === targetId;
          b.setAttribute('aria-selected', isTarget ? 'true' : 'false');

          if (isTarget) {
            b.classList.remove('bg-surface-card', 'border-crimson/40', 'text-neutral-300');
            b.classList.add('bg-crimson', 'text-white', 'shadow-lg', 'shadow-crimson/30', 'border-2', 'border-crimson');
          } else {
            b.classList.remove('bg-crimson', 'text-white', 'shadow-lg', 'shadow-crimson/30', 'border-2', 'border-crimson');
            b.classList.add('bg-surface-card', 'border-crimson/40', 'text-neutral-300');
          }
        });

        // Alterna os painéis correspondentes
        panels.forEach((panel) => {
          const panelId = panel.id;
          if (panelId === `sensei-panel-${targetId}`) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
      });
    });
  }

  // Executa no carregamento e em navegações do Astro
  setupSenseiTabs();
  document.addEventListener('astro:page-load', setupSenseiTabs);
</script>
